class Employee:
    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

    def calculate_salary(self, bonus):
        total_salary = self.salary + bonus
        return total_salary
emp1 = Employee("Jyoti", 20000)
bonus = 5000
total = emp1.calculate_salary(bonus)

print("Employee Name:", emp1.name)
print("Base Salary:", emp1.salary)
print("Bonus:", bonus)
print("Total Salary:", total)
